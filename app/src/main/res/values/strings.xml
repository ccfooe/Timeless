    <!-- Survival Guide Dialog -->
    <string name="survival_title">ColorOS / Android 后台保活指南</string>
    <string name="survival_desc">为确保下课倒计时常驻卡片与提前5分钟提醒在手机锁屏或灭屏时准时触发，请完成以下设置：</string>
    <string name="guide_step1_title">允许通知、锁屏显示与 ColorOS 流体云</string>
    <string name="guide_step1_desc">点击下方按钮进入通知设置，务必开启「允许通知」、「锁屏通知（显示全部内容）」及「流体云」实时胶囊开关。</string>
    <string name="guide_step2_title">忽略电池优化 (无限制)</string>
    <string name="guide_step2_desc">点击下方按钮，将本应用电池策略设置为「无限制/不优化」，避免系统休眠时冻结倒计时与闹钟。</string>
    <string name="guide_step3_title">ColorOS 允许自启动与关联启动</string>
    <string name="guide_step3_desc">进入系统设置 → 应用管理 → 自启动管理，将 Timeless 设为「允许自启动」。</string>
    <string name="guide_step4_title">多任务后台锁定</string>
    <string name="guide_step4_desc">上划进入多任务卡片页面，点击 Timeless 卡片右上角菜单，选择「锁定」，防止一键清理误杀。</string>
    <string name="btn_goto_notifications">前往设置：通知、锁屏与流体云权限</string>
    <string name="btn_goto_battery">前往设置：忽略电池优化</string>
    <string name="btn_goto_permissions">前往设置：应用权限详情</string>
    <string name="btn_understood_configured">我已了解并配置</string>
    <string name="btn_skip_for_now">暂不配置</string>

