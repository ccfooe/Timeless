<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_didi_card"
    android:orientation="vertical"
    android:paddingLeft="18dp"
    android:paddingTop="14dp"
    android:paddingRight="18dp"
    android:paddingBottom="14dp">

    <!-- Top Row: Icon + Header Texts + Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top Right Close Button -->
        <ImageView
            android:id="@+id/btn_stop"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_notification_close_btn"
            android:src="@drawable/ic_close_white"
            android:padding="6dp"
            android:contentDescription="结束下课" />

        <!-- Top Left Alarm Icon -->
        <ImageView
            android:id="@+id/iv_alarm_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_alarm_lightning"
            android:contentDescription="Class Status" />

        <!-- Top Middle Texts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iv_alarm_icon"
            android:layout_toStartOf="@id/btn_stop"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentTop="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="影视声音创作★"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Start time: 14:10 · 贡院401"
                android:textColor="#94A3B8"
                android:textSize="12.5sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Extra Info Row (Class & Period info) -->
    <TextView
        android:id="@+id/tv_extra_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="4dp"
        android:text="授课班级: 25级广电编03班 · 第1节/共2节"
        android:textColor="#64748B"
        android:textSize="11.5sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- Dotted Divider Line -->
    <TextView
        android:id="@+id/tv_dotted_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="························································································"
        android:textColor="#263044"
        android:textSize="14sp"
        android:letterSpacing="0.3"
        android:maxLines="1"
        android:ellipsize="none" />

    <!-- Bottom Row: Status & +5min pill on Left, Big Clean Time on Right -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_status_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="进行中 · 剩余 25 分钟"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/btn_extend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill_button"
                android:paddingLeft="9dp"
                android:paddingTop="3dp"
                android:paddingRight="9dp"
                android:paddingBottom="3dp"
                android:text="+5分"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_time_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="14:10"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Hidden compatibility view -->
    <ImageView
        android:id="@+id/iv_timeline_track"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
