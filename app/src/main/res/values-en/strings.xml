    <!-- Survival Guide Dialog -->
    <string name="survival_title">ColorOS / Android Survival Guide</string>
    <string name="survival_desc">To ensure lockscreen cards and alerts trigger reliably when screen is off, please complete:</string>
    <string name="guide_step1_title">Allow Notifications, Lock Screen &amp; Fluid Cloud</string>
    <string name="guide_step1_desc">Open notification settings, enable \'Allow notifications\', \'Lock screen content\' and \'Fluid Cloud\' capsule.</string>
    <string name="guide_step2_title">Disable Battery Optimization (Unrestricted)</string>
    <string name="guide_step2_desc">Set battery strategy to \'Unrestricted\' so alarms won\'t freeze when phone sleeps.</string>
    <string name="guide_step3_title">Allow Auto-launch in ColorOS</string>
    <string name="guide_step3_desc">Go to Settings → App Management → Auto-launch, set Timeless to \'Allowed\'.</string>
    <string name="guide_step4_title">Lock in Recent Tasks</string>
    <string name="guide_step4_desc">Swipe to Recents, tap menu on Timeless card, select \'Lock\' to prevent task clearing.</string>
    <string name="btn_goto_notifications">Go to Settings: Notifications &amp; Fluid Cloud</string>
    <string name="btn_goto_battery">Go to Settings: Battery Optimization</string>
    <string name="btn_goto_permissions">Go to Settings: App Permissions</string>
    <string name="btn_understood_configured">Understood &amp; Configured</string>
    <string name="btn_skip_for_now">Skip for Now</string>

