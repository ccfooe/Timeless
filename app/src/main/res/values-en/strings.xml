    <!-- User Guide Dialog -->
    <string name="user_guide_header">Timeless Beginner\'s Guide</string>
    <string name="guide_tab_scheduling">Scheduling</string>
    <string name="guide_tab_features">Class &amp; Lock Screen</string>
    <string name="mode_ai_title">Option A: AI Smart Import (Fast &amp; Automated)</string>
    <string name="mode_ai_desc">If you have an LLM API Key (configured in Settings), simply upload a screenshot of your syllabus or calendar. AI will extract course names, rooms, periods, and weeks in 3 seconds!</string>
    <string name="mode_manual_title">Option B: Offline Manual Scheduling (No API, 100% Privacy)</string>
    <string name="mode_manual_desc">No LLM API? Don\'t worry, Timeless fully supports offline manual scheduling:\n\n1. 【Period Table】: In Settings -> Period Times Table, customize your university\'s period times (preloaded with 10 standard periods).\n2. 【Add Course】: Switch to the \'Timetable\' tab, tap \'+\' to manually create courses with name, room, week range (e.g. Weeks 1-16), and periods (e.g. 1-2).\n3. 【Calendar &amp; Tasks】: Switch to \'Calendar\', tap \'+\' to add meetings, exams, and duties.</string>
    <string name="feature_lockscreen_title">Lock Screen Card &amp; ColorOS 16 Fluid Cloud</string>
    <string name="feature_lockscreen_desc">Tap \'Start a New Class\' on Today screen to activate live countdown. Lock screen displays full-width progress card; ColorOS 16 status bar and AOD show dynamic countdown capsule.</string>
    <string name="feature_warn_title">5-Min End Alert to Prevent Overrunning</string>
    <string name="feature_warn_desc">5 minutes before class ends (adjustable in Settings), your phone triggers a distinct vibration and banner to help you wrap up smoothly.</string>
    <string name="feature_privacy_title">Pure Local Storage &amp; JSON Backup</string>
    <string name="feature_privacy_desc">100% of your course and schedule data is stored strictly in your device\'s local database. Export JSON backups anytime for effortless migration.</string>
    <string name="btn_got_it">Got It</string>

